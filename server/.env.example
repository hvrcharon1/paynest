# ──────────────────────────────────────────────────────────────
# Oracle Database Connection
# ──────────────────────────────────────────────────────────────

# LOCAL DEVELOPMENT (Oracle 23ai Free)
ORACLE_USER=PAYNEST_APP
ORACLE_PASSWORD=your_local_password_here
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# PRODUCTION — OCI Autonomous Database (TLS-only, no wallet)
# Uncomment and set these when TLS-only is enabled on your ADB:
# ORACLE_CONNECT_STRING=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=<adb-host>.adb.<region>.oraclecloud.com))(connect_data=(service_name=<service>_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# PRODUCTION — OCI Autonomous Database (mTLS / Cloud Wallet)
# Set ORACLE_WALLET_CONTENT to the base64-encoded contents of your wallet .zip.
# To encode on Windows:  certutil -encode cwallet.sso.zip wallet_b64.txt
# To encode on Mac/Linux: base64 -i Wallet_MyADB.zip | tr -d '\n'
# ORACLE_WALLET_CONTENT=<base64-encoded-wallet-zip>
# ORACLE_WALLET_PASSWORD=<wallet-password-if-applicable>

# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
PORT=3000

# CORS: set to your Vercel production URL in production
# e.g. https://paynest.vercel.app
CORS_ORIGIN=http://localhost:5173
