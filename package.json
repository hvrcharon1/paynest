{
  "name": "paynest",
  "version": "1.0.0",
  "private": true,
  "description": "One nest for every payment you owe — manage payment methods, autopay every bill, and get AI-powered insight into your cash flow.",
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "cd client && npm run build",
    "typecheck": "cd client && npm run typecheck",
    "typecheck:server": "cd server && npx tsc --noEmit",
    "lint": "cd client && npm run lint"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
