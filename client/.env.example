# OAuth 2.0 "Web application" Client ID from Google Cloud Console.
# Create one at https://console.cloud.google.com/apis/credentials
# Add this app's dev/prod URLs (e.g. http://localhost:5173) under
# "Authorized JavaScript origins" — no client secret is needed.
VITE_GOOGLE_CLIENT_ID=

# Backend API URL (optional — defaults to /api via Vite proxy in dev)
# VITE_API_URL=http://localhost:3000/api
